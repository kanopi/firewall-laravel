<?xml version="1.0"?>
<ruleset name="Firewall Laravel">
    <description>Firewall Laravel Integration Coding Standards</description>
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="ignoreComments" value="true"/>
        </properties>
    </rule>

    <rule ref="PSR1" />
    <rule ref="PSR2" />
    <rule ref="PSR12" />
    <!-- Run against the PHPCompatibility ruleset -->
    <rule ref="PHPCompatibility"/>

    <!-- Exclude vendor directory -->
    <exclude-pattern>/vendor/*</exclude-pattern>

    <!-- Ignore warnings -->
    <arg name="warning-severity" value="0"/>

    <!--
      8.2, matching this package's own `php: >=8.2`. It was 8.1 while the
      constraint allowed Laravel 10 — checking a floor the package no longer
      supports would reject syntax it is now entitled to use.
    -->
    <config name="testVersion" value="8.2-"/>
</ruleset>
